# ==========================================
# AutoPatch-CI Root .gitignore
# ==========================================

# ---- OS & Editor Artifacts ----
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/settings.json
*.iml

# ---- Local Environment Variables ----
.env
.env.local
.env.*.local
*.env

# ---- Docker ----
docker-compose.override.yml

# ---- Python & Test Artifacts ----
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

