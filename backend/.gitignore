# ==========================================
# AutoPatch-CI Backend Python .gitignore
# ==========================================

# ---- Python Runtime ----
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pyc

# ---- Virtual Environments ----
.venv/
venv/
env/
ENV/
.env/

# ---- Distribution & Build Artifacts ----
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/

# ---- Poetry ----
poetry.lock
.poetry/

# ---- Testing & Coverage ----
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.lcov

# ---- Type Checking ----
.mypy_cache/
.dmypy.json
dmypy.json

# ---- Ruff ----
.ruff_cache/

# ---- Local .env ----
.env
.env.local

# ---- IDE ----
.idea/
.vscode/
*.iml
