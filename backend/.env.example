# Backend .env — AutoPatch-CI
# Copy .env.example to .env and fill in your credentials.
# !! NEVER commit this file to Git !!

# ---- LLM Settings ----
# Get your key from https://aistudio.google.com/app/apikey
# When set to a real key, the backend calls Gemini 3.5 Flash live.
# When empty or "mock-gemini-key", it uses a realistic deterministic fallback patch.
GEMINI_API_KEY=your-gemini-api-key-here

# ---- GitHub Integration (optional — leave empty for mock PR mode) ----
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_APP_ID=your-github-app-id
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ---- GCP Infrastructure (optional — leave empty unless deploying to GCP) ----
GCP_PROJECT_ID=your-gcp-project-id
PUBSUB_TOPIC_NAME=ci-failure-events

# ---- Pipeline Settings ----
# VERIFICATION_STRATEGY: mock | local_docker | cloud_build
VERIFICATION_STRATEGY=mock
MAX_PATCH_ATTEMPTS=3

# ---- App Environment ----
ENVIRONMENT=development
DEBUG=true
