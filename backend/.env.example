# ==============================================================================
# AutoPatch-CI Backend Environment Variables (.env)
# Copy this file to `backend/.env` and fill in your values.
# !! NEVER commit the actual `.env` file to Git !!
# ==============================================================================

# ── 1. Gemini LLM Settings (Required for AI code repairs) ─────────────────────
# Get free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...your-gemini-api-key

# ── 2. GitHub OAuth 2.0 (Required for Real GitHub Login) ──────────────────────
# Create an OAuth App at: https://github.com/settings/developers
# - Application name: AutoPatch-CI
# - Homepage URL: http://localhost:3000
# - Authorization callback URL: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
FRONTEND_URL=http://localhost:3000

# ── 3. GitHub Personal Access Token (For PR creation & repo fetching) ─────────
# Generate at: https://github.com/settings/tokens/new
# Scopes: repo, workflow, read:user
GITHUB_TOKEN=ghp_...your-personal-access-token
GITHUB_WEBHOOK_SECRET=your-custom-webhook-secret-string

# ── 4. Supabase Database (Required for Postgres persistence) ──────────────────
# Get from Supabase Project Settings -> API (https://supabase.com/dashboard)
# Execute `backend/src/autopatch/db/schema.sql` in the Supabase SQL Editor.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# ── 5. Pipeline & Execution Settings ──────────────────────────────────────────
# Options: mock | local_docker | cloud_build
VERIFICATION_STRATEGY=mock
MAX_PATCH_ATTEMPTS=3
ENVIRONMENT=development
DEBUG=true
