# AutoPatch-CI Frontend Environment Variable Template
# Copy this file to .env.local and fill in the actual values.
# !! NEVER commit .env.local to Git !!

# Backend API URL (defaults to localhost:8000 for local dev)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production example (Cloud Run URL after backend deployment):
# NEXT_PUBLIC_API_URL=https://autopatch-backend-service-xyz.run.app
