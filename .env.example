# ==============================================================================
# AutoPatch-CI Environment Configuration
# ==============================================================================

# Application
APP_NAME="AutoPatch-CI Agent API"
ENVIRONMENT="development"
DEBUG=true

# ------------------------------------------------------------------------------
# Google GenAI / Gemini
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL_NAME="gemini-2.0-flash"

# ------------------------------------------------------------------------------
# Google Cloud Platform (GCP) & Firestore
# ------------------------------------------------------------------------------
GCP_PROJECT_ID="your-gcp-project-id"
GCP_LOCATION="us-central1"
FIRESTORE_DATABASE="(default)"

# Path to your Google Cloud Service Account JSON Key file (for Firestore & Cloud Build)
GOOGLE_APPLICATION_CREDENTIALS=""
GCP_SERVICE_ACCOUNT_KEY_PATH=""

# ------------------------------------------------------------------------------
# GitHub Integration & OAuth App
# Create a GitHub OAuth App in:
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
# - Homepage URL: http://localhost:3000
# - Authorization callback URL: http://localhost:8000/api/auth/github/callback
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"
GITHUB_WEBHOOK_SECRET="your-webhook-secret"

# Optional personal access token
GITHUB_TOKEN=""

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Agent & Verification Execution
# ------------------------------------------------------------------------------
ADK_AGENT_ENABLED=true
MAX_PATCH_ATTEMPTS=3
VERIFICATION_STRATEGY="cloud_build" # "cloud_build" or "local_sandbox"
